{
  "name": "@hjr15/blaze-board",
  "version": "0.9.0",
  "description": "A file-based, git-native issue board that AI coding agents can drive. Tickets are markdown; status is the directory.",
  "keywords": [
    "issue-tracker",
    "project-management",
    "kanban",
    "markdown",
    "git",
    "cli",
    "ai-agents",
    "agentic"
  ],
  "homepage": "https://github.com/hjr15/blaze#readme",
  "bugs": {
    "url": "https://github.com/hjr15/blaze/issues"
  },
  "author": "Ryan Howman",
  "type": "module",
  "bin": {
    "blaze": "scripts/cli.mjs"
  },
  "files": [
    "scripts/",
    "!scripts/ci",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"if(require('./package.json').name==='@hjr15/blaze-board'){console.error('blaze: this tree is not published as @hjr15/blaze-board (ADR-0008 addendum): the line is frozen at 0.8.0; the next publish is the @hjr15/blaze rename');process.exit(1)}\"",
    "start": "node scripts/supervisor.mjs",
    "board": "node scripts/serve.mjs",
    "reconcile": "node scripts/reconcile.mjs",
    "groom": "node scripts/loops/groomer.mjs",
    "pretest": "node scripts/ci/require-engine.mjs",
    "test": "node --test --test-timeout=120000 --import=./tests/setup/hang-watchdog.mjs",
    "pretest:coverage": "node scripts/ci/require-engine.mjs",
    "test:coverage": "c8 node --test --test-concurrency=1 --test-timeout=120000 --import=./tests/setup/hang-watchdog.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjr15/blaze.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "acorn": "8.18.0",
    "c8": "11.0.0",
    "pg": "^8.16.0"
  },
  "peerDependencies": {
    "pg": "^8.16.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
